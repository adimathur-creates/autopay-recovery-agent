# Copy this file to .env and fill in your values. NEVER commit .env to Git.

# --- Razorpay (TEST mode only) ---
# Dashboard > switch to Test Mode > Account & Settings > API Keys > Generate Test Key
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx

# --- Voice provider ---
# "bolna" (used for the demo; calls Indian numbers) or "vapi" (optional alternative)
VOICE_PROVIDER=bolna

# Bolna: platform.bolna.ai > Developers > API Keys
BOLNA_API_KEY=bn-xxxxxxxxxxxxxxxxxxxxxxxx
# The agent created from bolna_setup/agent_config.json
BOLNA_AGENT_ID=

# Vapi (optional; see README "Why Bolna, not Vapi + Twilio")
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=

# --- Shared secret ---
# Any long random string. The voice platform sends it with every tool call and webhook,
# so only it can call your server. Must match the value inside the Bolna agent config.
VAPI_WEBHOOK_SECRET=change-me-to-something-long-and-random

# Your public tunnel URL, e.g. https://your-name.ngrok-free.dev (no trailing slash)
PUBLIC_URL=

# YOUR OWN mobile number (+91XXXXXXXXXX). Every call goes here only; fictional customers are never dialled.
TEST_PHONE=+91XXXXXXXXXX

# Local port (macOS uses 5000 for AirPlay)
PORT=5050
TEST_BASE_URL=http://localhost:5050
